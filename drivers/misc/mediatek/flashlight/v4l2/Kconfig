config MTK_FLASHLIGHT_OCP81378
	tristate "Mediatek flashlight with driver IC (OCS OCP81378)"
	depends on MTK_FLASHLIGHT
	help
	  This is for the flashlight driver IC (OCS OCP81378).

	  Say Y here if you want a flashlight driver IC OCP81378.
	  Select this only if your board has this IC.

	  Say M here if you want to compile this driver as a module.

config FLASHLIGHT_DEBUG
	bool "debug version build variant for flashlight driver"
	default n
	  help
	  This is used for flashlight driver to distinguishing user load and
	  eng/userdebug load.
	  Say Y if this is eng/userdebug load.
	  If not, say N.
