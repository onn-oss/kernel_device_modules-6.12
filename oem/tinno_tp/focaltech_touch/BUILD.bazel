load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl","kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
	name = "srcs",
	srcs = glob([
		"**/Makefile",
		"**/Kbuild",
		"**/*.c",
		"**/*.h",
	]),
)


define_mgk_ddk_ko(
    name = "focaltech_touch",
    srcs = [
        "focaltech_core.c",
        "focaltech_ex_fun.c",
        "focaltech_ex_mode.c",
        "focaltech_gesture.c",
        "focaltech_esdcheck.c",
        "focaltech_point_report_check.c",
        "focaltech_flash_spi.c",
        "focaltech_spi_v2.c",
        "focaltech_proximity.c",
        "focaltech_debug.c",
        "focaltech_hp.c",
    ],
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    copts = [
        "-Wall",
        "-Werror",
        "-I$(DEVICE_MODULES_PATH)/drivers/input/touchscreen/focaltech_touch/",
        "-I$(DEVICE_MODULES_PATH)/drivers/gpu/drm/mediatek/mediatek_v2/",
        "-I$(DEVICE_MODULES_PATH)/drivers/device_info",
    ],
	ko_deps = [
		"//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:mtk_disp_notify".format(kernel_version),
		"//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:mtk_panel_ext".format(kernel_version),
		"//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2/v1:mediatek_drm_v1".format(kernel_version),
		"//kernel_device_modules-{}/drivers/spi:spi-mt65xx".format(kernel_version),
		"//kernel_device_modules-{}/drivers/input/touchscreen/tui_common:tui-common".format(kernel_version),
		"//kernel_device_modules-{}/drivers/device_info:device_info".format(kernel_version),
		"//kernel_device_modules-{}/drivers/gpu/drm/panel:panel-boe-ft8206-vdo".format(kernel_version),
	],
	header_deps = [
        "//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:ddk_public_headers".format(kernel_version),
    ],
)
