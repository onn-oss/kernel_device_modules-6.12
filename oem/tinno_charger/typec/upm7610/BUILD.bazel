load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_src",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
        "*.h",
    ]),
)

define_mgk_ddk_ko(
    name = "upm7610",
    srcs = [
        "tcpc_upm7610.c",
    ],
    hdrs = glob([
        "upm7610.h"
    ]),
    ko_deps = [
        "//kernel_device_modules-{}/drivers/misc/mediatek/typec/tcpc:tcpc_class".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/typec/tcpc:pd_dbg_info".format(kernel_version),
        "//kernel_device_modules-{}/drivers/power/supply:charger_class".format(kernel_version),
    ],
    includes = ["."],
    copts = [
        "-Wall",
        "-Werror",
        "-Wno-unused-but-set-variable",
        "-DCONFIG_RT_REGMAP",
        "-I$(DEVICE_MODULES_PATH)/drivers/power/supply/",
        "-I$(DEVICE_MODULES_PATH)/drivers/mfd/",
    ],
)

