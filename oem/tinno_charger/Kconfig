config OEM_TINNO_CHARGER
	tristate "oem tinno charger"
	default n
	help
	  support oem_tinno_charger

config OEM_SWITCH_CHARGER
	tristate "oem third party switch charger support"
	depends on OEM_TINNO_CHARGER
	default n
	help
	  support oem_switch_charger

